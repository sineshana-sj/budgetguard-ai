# Environment configuration for BudgetGuard AI
# Copy to .env and configure for your AWS and Decider environment

# Backend Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000"]

# Mode: 'live' (requires AWS credentials & model access) or 'demo' (deterministic, verifiable simulation)
APP_MODE=demo

# AWS Configuration (Used when APP_MODE=live)
AWS_REGION=us-east-1
AWS_PROFILE=default
# Optional explicit credentials (default AWS credential chain is preferred)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Amazon Bedrock Model Identifiers
BEDROCK_LIGHTWEIGHT_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_ADVANCED_MODEL_ID=amazon.nova-pro-v1:0
# Alternative Claude IDs:
# BEDROCK_LIGHTWEIGHT_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# BEDROCK_ADVANCED_MODEL_ID=anthropic.claude-3-7-sonnet-20250219-v1:0

# Strands Decider 2B Configuration
# Model identifier for local weights or served endpoint
DECIDER_MODEL_ID=StrandsAgents/strands-decider-2B-hobson-v19
# Optional remote Decider HTTP endpoint (e.g., http://localhost:8001 or LiteLLM /v1/systemone)
DECIDER_ENDPOINT=
# Confidence threshold below which the router acts conservatively or flags low confidence
DECIDER_CONFIDENCE_THRESHOLD=0.65

# Storage
DATABASE_URL=sqlite+aiosqlite:///./budgetguard.db
PERSIST_RAW_PROMPTS=false
